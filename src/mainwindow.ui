  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #2b2b2b;
    color: #ffffff;
}
QGroupBox {
    color: #ffffff;
    font-weight: bold;
    border: 2px solid #555555;
    border-radius: 8px;
    margin-top: 1ex;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 8px;
    background-color: #2b2b2b;
    color: #ffffff;
}
QPushButton {
    background-color: #404040;
    color: white;
    border: 1px solid #555555;
    border-radius: 5px;
    padding: 8px 16px;
    font-weight: bold;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #4a4a4a;
    border: 1px solid #666666;
}
QPushButton:pressed {
    background-color: #2a82da;
}
QPushButton:disabled {
    background-color: #333333;
    color: #666666;
}
QProgressBar {
    border: 1px solid #555555;
    border-radius: 5px;
    text-align: center;
    color: white;
    background-color: #353535;
}
QProgressBar::chunk {
    background-color: #2a82da;
    border-radius: 4px;
}
QComboBox {
    background-color: #353535;
    color: white;
    border: 1px solid #555555;
    border-radius: 5px;
    padding: 5px;
    min-height: 25px;
}
QComboBox:disabled {
    background-color: #2a2a2a;
    color: #666666;
}
QTextEdit {
    background-color: #1a1a1a;
    color: #00ff00;
    border: 1px solid #555555;
    border-radius: 5px;
    font-family: 'Courier New', monospace;
    font-size: 10pt;
    selection-background-color: #2a82da;
}
QLabel {
    color: #ffffff;
}
</string>
